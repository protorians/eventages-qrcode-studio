{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Eventages Lite",
  "version": "0.7.1",
  "identifier": "com.protorians.qrcode-studio",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Eventages Lite",
        "width": 1280,
        "height": 768,
        "minWidth": 720,
        "minHeight": 500,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
